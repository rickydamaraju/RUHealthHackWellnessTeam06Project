{
  "name": "glucose-compass",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["frontend", "mobile", "infrastructure", "packages/contracts", "packages/api-client"],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:api": ".venv/bin/python -m uvicorn app.main:app --app-dir backend --env-file .env --host 127.0.0.1 --port 8000 --reload",
    "build": "npm run build --workspace frontend",
    "check": "npm run check --workspaces --if-present",
    "test:backend": "PYTHONPATH=backend .venv/bin/python -m pytest backend/tests -q",
    "synth": "npm run synth --workspace infrastructure",
    "deploy": "npm run deploy --workspace infrastructure"
  },
  "engines": { "node": ">=22.12.0" }
}
